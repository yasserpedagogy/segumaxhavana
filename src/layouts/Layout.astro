---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/900.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'SEGUMAX | Infraestructura de Seguridad & Energía Solar',
  description = 'Empresa de seguridad electrónica en La Habana. Alarmas, videovigilancia CCTV y sistemas fotovoltaicos autosustentables con ingeniería de vanguardia.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-gris-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <!-- bg-gris-50 plano base quirúrgico y text-gris-900 para un contraste tipográfico masivo y limpio estilo catálogo -->
  <body class="relative flex min-h-screen flex-col bg-gris-50 font-sans text-gris-900 antialiased selection:bg-mostaza-500 selection:text-gris-900">
    
    <!-- Línea sutil de acento mostaza en el borde superior del navegador (Detalle de alta ingeniería) -->
    <div class="h-1 w-full bg-mostaza-500 sticky top-0 z-50"></div>

    <!-- Navegación Superior Escandinava -->
    <Header />
    
    <!-- Área de Contenido Editorial Principal -->
    <main class="flex-1 w-full">
      <slot />
    </main>
    
    <!-- Cierre Técnico perimetral -->
    <Footer />
  </body>
</html>
