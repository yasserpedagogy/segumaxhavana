---
import Container from './Container.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<section class="bg-gris-50 py-24 lg:py-36 border-b border-gris-200 overflow-hidden">
  <Container>
    <!-- Technical Specification Link Header -->
    <div class="flex items-center justify-between border-b border-gris-200 pb-4 mb-16">
      <div class="kicker flex items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full animate-pulse"></span>
        <span>NODO DE CONVERSIÓN // TERMINAL DE CONTACTO</span>
      </div>
      <span class="font-mono text-[10px] text-gris-400 tracking-widest">GATE_READY_04</span>
    </div>

    <!-- Main Layout Content Grid -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-20 items-start">
      
      <!-- Left Column: Final Conversion Directive -->
      <div class="space-y-8">
        <span class="font-mono text-xs text-mostaza-500 block tracking-wider">// DESACOPLE INMEDIATO DE RED PUBLIC_A</span>
        <h2 class="display-lg text-4xl lg:text-6xl text-gris-900 uppercase tracking-tight leading-none">
          Inicie el diseño <br />
          de su infraestructura <br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">autónoma</span>.
        </h2>
        <p class="max-w-xl text-base lg:text-lg leading-relaxed text-gris-500 font-light">
          Centralice su sistema perimetral de seguridad y matriz fotovoltaica bajo la dirección de especialistas titulados. Respuestas de ingeniería coordinadas desde nuestro centro logístico en La Habana.
        </p>
      </div>

      <!-- Right Column: Technical Communication Hub Layout -->
      <div class="w-full grid grid-cols-1 gap-px bg-gris-200 border border-gris-200">
        
        <!-- Primary Action: Direct Line -->
        <a 
          href="tel:+5355555555" 
          class="bg-white p-6 flex flex-col justify-between group transition-colors duration-300 hover:bg-gris-900 hover:text-white relative"
        >
          <span class="font-mono text-[9px] text-gris-400 group-hover:text-mostaza-500 tracking-widest block mb-4">[ CANAL // TELÉFONO ]</span>
          <div class="flex items-center justify-between">
            <span class="text-xl font-bold tracking-tight font-mono">+53 5555 5555</span>
            <div class="w-7 h-7 rounded-full bg-gris-50 border border-gris-200 flex items-center justify-center group-hover:bg-mostaza-500 group-hover:border-mostaza-500 group-hover:text-gris-900 transition-colors">
              <ArrowUpRight class="h-3.5 w-3.5 stroke-[1.5]" />
            </div>
          </div>
        </a>

        <!-- Secondary Action: Secure Messaging (WhatsApp) -->
        <a 
          href="https://wa.me/5355555555" 
          class="bg-white p-6 flex flex-col justify-between group transition-colors duration-300 hover:bg-gris-900 hover:text-white relative"
        >
          <span class="font-mono text-[9px] text-gris-400 group-hover:text-mostaza-500 tracking-widest block mb-4">[ EMERGENCIAS // WHATSAPP ]</span>
          <div class="flex items-center justify-between">
            <span class="text-xl font-bold tracking-tight font-mono">CONEXIÓN DIGITAL</span>
            <div class="w-7 h-7 rounded-full bg-gris-50 border border-gris-200 flex items-center justify-center group-hover:bg-mostaza-500 group-hover:border-mostaza-500 group-hover:text-gris-900 transition-colors">
              <ArrowUpRight class="h-3.5 w-3.5 stroke-[1.5]" />
            </div>
          </div>
        </a>

        <!-- Informational Metric Block: Fixed Location Coordinate -->
        <div class="bg-white p-6 flex flex-col justify-between relative">
          <span class="font-mono text-[9px] text-gris-400 tracking-widest block mb-4">[ LOGÍSTICA // MATRIZ ]</span>
          <div class="flex justify-between items-baseline font-mono">
            <span class="text-sm font-semibold text-gris-900 uppercase">LA HABANA, CUBA</span>
            <span class="text-[10px] text-gris-400 tracking-tighter">[ 23.1136° N, 82.3666° W ]</span>
          </div>
        </div>

      </div>

    </div>
  </Container>
</section>
