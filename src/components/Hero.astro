---
import Container from './Container.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<section class="bg-gris-50 pt-20 pb-24 lg:pt-28 lg:pb-36 overflow-hidden">
  <Container>
    <!-- Kicker superior con formato de metadato técnico -->
    <div class="flex items-center justify-between border-b border-gris-200 pb-4">
      <div class="kicker flex items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full animate-pulse"></span>
        <span>INFRAESTRUCTURA ACTIVA // LA HABANA</span>
      </div>
      <span class="font-mono text-[10px] text-gris-400 tracking-widest">SYS_REF: 2026-HZ</span>
    </div>

    <!-- Título Editorial Masivo Comprimido -->
    <h1 class="display-xl mt-12 max-w-6xl text-[clamp(2.5rem,7.5vw,6rem)] text-gris-900 tracking-tighter">
      PROTECCIÓN <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">AUTÓNOMA</span>. <br />
      ALIMENTADA POR <span class="text-mostaza-500">EL SOL</span>.
    </h1>

    <!-- Grid Asimétrico -->
    <div class="mt-16 grid grid-cols-1 gap-12 lg:mt-20 lg:grid-cols-[1.3fr_1fr] lg:gap-20 items-end">
      <!-- Texto e información -->
      <div class="space-y-10">
        <p class="max-w-xl text-xl leading-relaxed text-gris-600 font-light">
          Diseñamos arquitectura de seguridad electrónica blindada. Fusionamos
          sistemas de alarma avanzados y circuitos cerrados de CCTV de alta
          resolución con matrices fotovoltaicas independientes. Protección
          ininterrumpida, inmune a fallos de red.
        </p>

        <!-- Botones de acción modulares -->
        <div class="flex flex-wrap items-center gap-4 font-mono text-xs">
          <a
            href="/contacto"
            class="group inline-flex items-center gap-3 bg-gris-900 text-white px-8 py-4 uppercase tracking-wider transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 shadow-sm"
          >
            Solicitar inspección técnica
            <ArrowUpRight
              class="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              stroke-width={2}
            />
          </a>

          <a
            href="/servicios"
            class="border border-gris-200 bg-white px-8 py-4 uppercase tracking-wider text-gris-700 transition-colors duration-300 hover:border-gris-900 hover:text-gris-900"
          >
            [ Catálogo de Dispositivos ]
          </a>
        </div>
      </div>

      <!-- Contenedor del objeto de diseño -->
      <div class="relative group">
        <div class="ikea-box bg-white p-6 md:p-8 border border-gris-200 relative">
          <!-- Número de artículo -->
          <span class="absolute top-4 right-4 font-mono text-[9px] text-gris-400 tracking-wider">
            ART. N° 904.811.02
          </span>

          <!-- Estado técnico -->
          <div class="font-mono text-[11px] text-gris-400 mb-6 flex items-center gap-2">
            <span>[ FIG_01 // NÚCLEO_INTEGRADO ]</span>
          </div>

          <!-- Cuadro de visualización del producto -->
          <div class="relative aspect-square w-full overflow-hidden bg-gris-100 border border-gris-200 flex items-center justify-center p-0">
            <!-- Rejilla técnica de fondo -->
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#E5E7EB_1px,transparent_1px),linear-gradient(to_bottom,#E5E7EB_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] opacity-25 z-10 pointer-events-none"></div>

            <!-- Imagen real -->
            <img
              src="/images/hero-cctv.jpg"
              alt="Módulo de Protección Óptica"
              class="w-full h-full object-cover filter grayscale contrast-115 brightness-105 transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Acento mostaza en esquina -->
            <div class="absolute bottom-0 right-0 h-12 w-12 bg-mostaza-500 transition-transform duration-500 group-hover:scale-110 z-20"></div>
          </div>

          <!-- Especificaciones inferiores -->
          <div class="mt-6 flex items-center justify-between text-xs border-t border-gris-200 pt-4 font-mono">
            <span class="kicker text-gris-900 font-semibold">MÓDULO AUTÓNOMO DE PROTECCIÓN</span>
            <span class="text-gris-400">ED_01 // 12</span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<!-- Regla horizontal de separación -->
<div class="editorial-rule"></div>