---
import { Shield, Phone, CheckCircle2 } from '@lucide/astro';
import Container from './Container.astro';

const bullets = [
  'Visita de diagnóstico gratuita',
  'Soluciones a la medida de tu presupuesto',
  'Soporte técnico 24/7',
];
---

<section class="relative overflow-hidden bg-segumax-primary text-white">
  <div class="absolute inset-0 bg-gradient-to-br from-segumax-primary via-segumax-primary to-segumax-primary-dark" />
  <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-segumax-accent/10 blur-3xl" />
  <div class="absolute -bottom-32 -left-32 h-96 w-96 rounded-full bg-segumax-accent/5 blur-3xl" />

  <Container class="relative py-20 lg:py-28">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
      <!-- Contenido -->
      <div>
        <div class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-1.5 backdrop-blur">
          <Shield class="h-4 w-4 text-segumax-accent" />
          <span class="font-display text-sm font-medium tracking-wider">
            MÁS DE 12 AÑOS PROTEGIENDO CUBA
          </span>
        </div>

        <h1 class="font-display mt-6 text-5xl font-bold leading-tight tracking-tight lg:text-6xl">
          Máxima protección para tu <span class="text-segumax-accent">hogar y negocio</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg text-white/80">
          Alarmas AJAX, videovigilancia profesional, automatización y respaldo
          energético con paneles solares. No vendemos equipos, proponemos soluciones.
        </p>

        <ul class="mt-8 space-y-3">
          {bullets.map((item) => (
            <li class="flex items-center gap-3">
              <CheckCircle2 class="h-5 w-5 flex-shrink-0 text-segumax-accent" />
              <span class="text-white/90">{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/contacto"
            class="font-display inline-flex items-center gap-2 rounded-lg bg-segumax-accent px-6 py-3 text-lg font-semibold tracking-wide text-white transition hover:bg-segumax-accent-hover"
          >
            Solicitar visita gratuita
          </a>
          <a
            href="tel:+5355555555"
            class="font-display inline-flex items-center gap-2 rounded-lg border border-white/20 bg-white/5 px-6 py-3 text-lg font-semibold tracking-wide text-white backdrop-blur transition hover:bg-white/10"
          >
            <Phone class="h-5 w-5" />
            Llamar ahora
          </a>
        </div>
      </div>

      <!-- Imagen placeholder -->
      <div class="relative">
        <div class="aspect-square rounded-2xl border border-white/10 bg-white/5 backdrop-blur">
          <div class="flex h-full items-center justify-center">
            <Shield class="h-32 w-32 text-white/20" stroke-width={1} />
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>