---
import Container from './Container.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<section class="bg-gris-50 py-24 lg:py-36 border-b border-gris-200 overflow-hidden">
  <Container>
    <!-- Encabezado con formato de especificación técnica -->
    <div class="flex items-center justify-between border-b border-gris-200 pb-4 mb-16">
      <div class="kicker flex items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 bg-mostaza-500 rounded-full"></span>
        <span>INFRAESTRUCTURA ENERGÉTICA // AUTONOMÍA TRIPLE</span>
      </div>
      <span class="font-mono text-[10px] text-gris-400 tracking-widest">REF: SOLAR_SYS_2026</span>
    </div>

    <!-- Grid simétrico de catálogo industrial -->
    <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1.2fr_1fr] lg:gap-24 items-center">
      
      <!-- Bloque de Texto: Ingeniería de Respaldo Absoluto -->
      <div class="space-y-8">
        <h2 class="display-lg text-4xl lg:text-6xl text-gris-900 uppercase tracking-tight">
          PROTECCIÓN <br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">ININTERRUMPIDA</span> <br />
          SIN RED ELÉCTRICA.
        </h2>

        <p class="max-w-xl text-lg lg:text-xl leading-relaxed text-gris-600 font-light">
          Diseñamos matrices de celdas monocristalinas y sistemas de inversión híbrida optimizados para La Habana. Al desacoplar la alimentación de sus circuitos cerrados y alarmas de la red pública, garantizamos un blindaje perimetral absoluto que opera con total normalidad de forma indefinida.
        </p>

        <!-- Botón modular tipo bloque técnico -->
        <div class="pt-4">
          <a
            href="/servicios/energia-solar"
            class="group inline-flex items-center gap-3 bg-white border border-gris-200 px-8 py-4 font-mono text-xs uppercase tracking-wider text-gris-900 transition-colors duration-300 hover:border-gris-900 hover:bg-gris-50 shadow-sm"
          >
            Especificaciones del Sistema
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width={2} />
          </a>
        </div>
      </div>

      <!-- Bloque de Imagen: Render Técnico del Objeto en Caja de Catálogo -->
      <div class="relative group">
        <div class="ikea-box bg-white p-6 md:p-8 border border-gris-200 relative">
          <!-- Número de inventario simulado -->
          <span class="absolute top-4 right-4 font-mono text-[9px] text-gris-400 tracking-wider">ART. N° 302.511.90</span>
          
          <!-- Estado y Datos de Carga en números tabulares -->
          <div class="font-mono text-[11px] text-gris-400 mb-6 flex justify-between items-center">
            <span>[ COMPONENTE_03 // MATRIZ_SOLAR ]</span>
            <span class="text-mostaza-600 font-semibold tracking-tighter">EFF // 22.8%</span>
          </div>

          <!-- Cuadro contenedor del producto fotovoltaico -->
          <div class="relative aspect-[4/4] w-full overflow-hidden bg-gris-100 border border-gris-200 flex items-center justify-center p-8">
            <div class="absolute inset-0 bg-[linear-gradient(to_right,#E5E7EB_1px,transparent_1px),linear-gradient(to_bottom,#E5E7EB_1px,transparent_1px)] bg-[size:2rem_2rem] opacity-25"></div>
            
            <div class="text-center z-10 space-y-2">
              <span class="block kicker text-gris-400">PLANO FOTOVOLTAICO MODULAR</span>
              <span class="font-mono text-[10px] text-gris-400 font-light">[ Celda Monocristalina / Absorción Pasiva ]</span>
            </div>

            <!-- Detalle Mostaza de Conexión Técnica en Esquina -->
            <div class="absolute bottom-0 left-0 h-1 w-16 bg-mostaza-500 transition-all duration-300 group-hover:h-3"></div>
          </div>

          <!-- Pie de Ficha Industrial -->
          <div class="mt-6 flex items-center justify-between text-xs border-t border-gris-200 pt-4 font-mono">
            <span class="kicker text-gris-900 font-semibold">RESPALDO FOTOVOLTAICO AUTÓNOMO</span>
            <span class="text-gris-400">03 / 12</span>
          </div>
        </div>
      </div>

    </div>
  </Container>
</section>
