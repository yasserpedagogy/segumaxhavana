---
import Container from './Container.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<section class="bg-white py-20 lg:py-28 border-b border-gris-200 overflow-hidden">
  <Container>
    <!-- Technical Blueprint Data Link -->
    <div class="flex items-center justify-between border-b border-gris-200 pb-4 mb-12">
      <div class="kicker flex items-center gap-3">
        <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full"></span>
        <span>PROGRAMA DE INGENIERÍA // AUDITORÍA PERIMETRAL</span>
      </div>
      <span class="font-mono text-[10px] text-gris-400 tracking-widest">TICKET: REQ_VISIT</span>
    </div>

    <!-- Layout Grid -->
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-20 items-end">
      
      <!-- Primary Core Headline -->
      <div class="space-y-6">
        <span class="font-mono text-xs text-mostaza-500 block tracking-wider">// SOLICITUD DE REVISIÓN EN SITIO</span>
        <h2 class="display-lg text-3xl lg:text-5xl text-gris-900 uppercase tracking-tight leading-tight">
          Evaluación técnica <br />
          de vulnerabilidades <br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">coste cero</span>.
        </h2>
      </div>

      <!-- Detail specifications and tactical CTA button -->
      <div class="space-y-8">
        <p class="text-sm lg:text-base leading-relaxed text-gris-500 font-light">
          Inspección perimetral y dimensionamiento fotovoltaico sin compromiso de contratación en La Habana. Emitimos un reporte estructural detallado especificando los nodos críticos de cobertura inalámbrica, ópticas y almacenamiento energético modular.
        </p>
        
        <div class="pt-2">
          <a
            href="/contacto"
            class="group inline-flex w-full sm:w-auto items-center justify-between gap-6 bg-gris-900 text-white font-mono text-xs uppercase tracking-wider px-8 py-4 transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 shadow-sm"
          >
            <span>Agendar Inspección _</span>
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width={2} />
          </a>
        </div>
      </div>

    </div>
  </Container>
</section>
