---
import { CalendarCheck, Phone } from '@lucide/astro';
import Container from './Container.astro';
---

<section class="bg-segumax-bg py-20">
  <Container>
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-segumax-accent to-segumax-accent-hover p-10 lg:p-16">
      <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl" />
      <div class="absolute -bottom-20 -left-20 h-64 w-64 rounded-full bg-white/5 blur-3xl" />

      <div class="relative grid grid-cols-1 items-center gap-8 lg:grid-cols-[2fr_1fr]">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-1.5 backdrop-blur">
            <CalendarCheck class="h-4 w-4 text-white" />
            <span class="font-display text-sm font-medium tracking-wider text-white">
              VISITA SIN COMPROMISO
            </span>
          </div>

          <h2 class="font-display mt-6 text-4xl font-bold leading-tight tracking-tight text-white lg:text-5xl">
            Hacemos visitas gratuitas y te ayudamos a pensar con seguridad
          </h2>

          <p class="mt-4 max-w-2xl text-lg text-white/90">
            Libre de costo y sin compromiso de contratación. Evaluamos tu
            propiedad y te proponemos la mejor solución.
          </p>
        </div>

        <div class="flex flex-col gap-3">
          <a
            href="/contacto"
            class="font-display inline-flex items-center justify-center gap-2 rounded-lg bg-segumax-primary px-6 py-4 text-lg font-semibold tracking-wide text-white transition hover:bg-segumax-primary-dark"
          >
            Agendar visita
          </a>
          <a
            href="tel:+5355555555"
            class="font-display inline-flex items-center justify-center gap-2 rounded-lg border-2 border-white/40 bg-white/5 px-6 py-4 text-lg font-semibold tracking-wide text-white backdrop-blur transition hover:bg-white/10"
          >
            <Phone class="h-5 w-5" />
            Llamar ahora
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>