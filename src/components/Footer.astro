---
import Container from './Container.astro';

const year = new Date().getFullYear();

const servicios = [
  { label: 'ALARMAS AJAX', href: '/servicios/alarmas-ajax' },
  { label: 'VIDEOVIGILANCIA CCTV', href: '/servicios/videovigilancia' },
  { label: 'DETECCIÓN INCENDIO', href: '/servicios/incendio' },
  { label: 'AUTOMATIZACIÓN DOMÓTICA', href: '/servicios/automatizacion' },
  { label: 'RESPALDO ENERGÍA SOLAR', href: '/servicios/energia-solar' },
];

const empresa = [
  { label: 'MANIFIESTO / NOSOTROS', href: '/nosotros' },
  { label: 'SOLUCIONES POR SECTOR', href: '/soluciones' },
  { label: 'ARCHIVO / GALERÍA', href: '/galeria' },
  { label: 'OFICINA / CONTACTO', href: '/contacto' },
];

const contacto = [
  { label: '+53 5555 5555', href: 'tel:+5355555555' },
  { label: 'CANAL WHATSAPP', href: 'https://wa.me/5355555555' },
  { label: 'INFO@SEGUMAXHAVANA.COM', href: 'mailto:info@segumaxhavana.com' },
];
---

<footer class="bg-gris-50 border-t border-gris-200 overflow-hidden">
  <Container>
    <!-- Top Branding & Abstract Description Block -->
    <div class="border-b border-gris-200 py-16 lg:py-20 grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-8 items-start">
      <div class="space-y-2">
        <div class="flex items-center gap-3">
          <span class="font-mono text-xs text-gris-400 select-none tracking-widest">[ SYSTEM_END ]</span>
          <span class="text-2xl font-black tracking-tighter text-gris-900 uppercase">
            SEGUMAX<span class="text-marino-500 font-normal">_</span>
          </span>
        </div>
        <div class="font-mono text-[10px] text-gris-400 tracking-wider">ESTÁNDAR NÓRDICO // INFRAESTRUCTURA DE ALTA FIDELIDAD</div>
      </div>
      <p class="text-sm leading-relaxed text-gris-500 font-light max-w-xl lg:justify-self-end">
        Ingeniería integrada de protección perimetral, analítica digital y redes de soporte fotovoltaico desacopladas. Diseñado de forma limpia y transparente para optimizar infraestructuras residenciales y corporativas en La Habana.
      </p>
    </div>

    <!-- Structured Index Grid -->
    <div class="grid grid-cols-2 gap-x-8 gap-y-12 py-16 lg:grid-cols-4 lg:gap-16 border-b border-gris-200">
      
      <!-- Services Index Column -->
      <div class="space-y-6">
        <div class="kicker text-gris-900 font-semibold tracking-wider">[ 01 // SERVICIOS ]</div>
        <ul class="space-y-3 font-mono text-[11px] tracking-wide">
          {servicios.map((item) => (
            <li>
              <a href={item.href} class="text-gris-500 transition-colors duration-300 hover:text-mostaza-600">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Studio Index Column -->
      <div class="space-y-6">
        <div class="kicker text-gris-900 font-semibold tracking-wider">[ 02 // EMPRESA ]</div>
        <ul class="space-y-3 font-mono text-[11px] tracking-wide">
          {empresa.map((item) => (
            <li>
              <a href={item.href} class="text-gris-500 transition-colors duration-300 hover:text-mostaza-600">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Terminal Communications Column -->
      <div class="space-y-6">
        <div class="kicker text-gris-900 font-semibold tracking-wider">[ 03 // CONTACTO ]</div>
        <ul class="space-y-3 font-mono text-[11px] tracking-wide">
          {contacto.map((item) => (
            <li>
              <a href={item.href} class="text-gris-500 transition-colors duration-300 hover:text-mostaza-600">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Physical Logistical Placement Area -->
      <div class="space-y-6">
        <div class="kicker text-gris-900 font-semibold tracking-wider">[ 04 // LOGÍSTICA ]</div>
        <div class="space-y-2 text-sm text-gris-500 font-light leading-relaxed">
          <p class="font-sans font-medium text-gris-900">LA HABANA · CUBA</p>
          <p class="font-mono text-[11px] text-gris-400">Despliegue operativo perimetral e ingeniería a nivel nacional.</p>
        </div>
      </div>
    </div>

    <!-- Technical System Bottom Credits Footer -->
    <div class="py-8 flex flex-col sm:flex-row justify-between items-center gap-4 font-mono text-[10px] text-gris-400 tracking-wider">
      <div>
        © {year} SEGUMAX INC. TODOS LOS DERECHOS REGISTRADOS.
      </div>
      <div class="flex items-center gap-4 select-none">
        <span>[ FILTRADO_CERRADO: OK ]</span>
        <span class="flex items-center gap-1.5 text-marino-500 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-marino-500 animate-pulse"></span> SYS_ACTIVE
        </span>
      </div>
    </div>
  </Container>
</footer>
