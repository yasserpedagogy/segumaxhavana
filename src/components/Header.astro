---
import { Menu, X, Phone } from '@lucide/astro';
import Container from './Container.astro';

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Soluciones', href: '/soluciones' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Galería', href: '/galeria' },
  { label: 'Contacto', href: '/contacto' },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-50 border-b border-gris-200 bg-gris-50/80 backdrop-blur-md">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4 lg:h-20">
      
      <!-- Logo Minimalista Estilo Diseño Industrial -->
      <a href="/" class="flex items-center gap-3 group">
        <span class="font-mono text-xs text-gris-400 select-none tracking-widest">[ SEC // SYS ]</span>
        <span class="text-xl font-black tracking-tighter text-gris-900 uppercase">
          SEGUMAX<span class="text-marino-500 font-normal">_</span>
        </span>
      </a>

      <!-- Navegación de Escritorio Estilo Catálogo Editorial -->
      <nav class="hidden items-center gap-8 lg:flex">
        {navLinks.map((link, index) => (
          <a
            href={link.href}
            class:list={[
              'font-mono text-xs tracking-wider transition-colors duration-300 flex items-center gap-1.5 py-2',
              isActive(link.href)
                ? 'text-gris-900 font-semibold border-b border-gris-900'
                : 'text-gris-500 hover:text-gris-900',
            ]}
          >
            <span class:list={[
              'text-[9px] select-none',
              isActive(link.href) ? 'text-mostaza-500' : 'text-gris-300'
            ]}>0{index + 1}.</span>
            {link.label.toUpperCase()}
          </a>
        ))}
      </nav>

      <!-- CTA de Escritorio: Módulo de Enlace Técnico -->
      <a
        href="tel:+5355555555"
        class="hidden items-center gap-2.5 bg-white border border-gris-200 px-5 py-2.5 font-mono text-xs uppercase text-gris-900 transition-colors duration-300 hover:border-gris-900 hover:bg-gris-50 lg:flex"
      >
        <Phone class="h-3.5 w-3.5 text-mostaza-500" stroke-width={2} />
        +53 5555 5555
      </a>

      <!-- Botón de Menú Móvil Limpio -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="p-2 text-gris-900 hover:text-mostaza-500 transition-colors lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <Menu class="h-6 w-6" id="icon-menu" stroke-width={1.5} />
        <X class="hidden h-6 w-6" id="icon-close" stroke-width={1.5} />
      </button>
    </div>

    <!-- Menú Móvil Desplegable Estilo Panel de Control -->
    <div id="mobile-menu" class="hidden border-t border-gris-200 pb-8 pt-4 lg:hidden">
      <nav class="flex flex-col gap-1">
        {navLinks.map((link, index) => (
          <a
            href={link.href}
            class:list={[
              'font-mono text-xs tracking-wider py-3 border-b border-gris-100 flex items-center gap-2 transition-colors',
              isActive(link.href)
                ? 'text-gris-900 font-semibold pl-2 border-l-2 border-l-mostaza-500'
                : 'text-gris-500 hover:text-gris-900',
            ]}
          >
            <span class="text-[9px] text-gris-400">0{index + 1}//</span>
            {link.label.toUpperCase()}
          </a>
        ))}
        <a
          href="tel:+5355555555"
          class="mt-6 flex items-center justify-center gap-2 bg-gris-900 text-white font-mono text-xs uppercase py-4 tracking-widest hover:bg-mostaza-500 hover:text-gris-900 transition-colors"
        >
          <Phone class="h-4 w-4" stroke-width={1.5} />
          +53 5555 5555
        </a>
      </nav>
    </div>
  </Container>
</header>

<script is:inline>
  (function () {
    function init() {
      var toggle = document.getElementById('mobile-menu-toggle');
      var menu = document.getElementById('mobile-menu');
      var iconMenu = document.getElementById('icon-menu');
      var iconClose = document.getElementById('icon-close');

      if (!toggle || !menu || !iconMenu || !iconClose) return;
      if (toggle.dataset.bound === '1') return;
      toggle.dataset.bound = '1';

      toggle.addEventListener('click', function () {
        var isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        iconMenu.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
