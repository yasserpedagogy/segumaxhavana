---
import { Home, Building2, ArrowRight } from '@lucide/astro';
import Container from './Container.astro';

const solutions = [
  {
    icon: Home,
    title: 'Para Hogares',
    description:
      'Ofrecemos soluciones de respaldo y protección para tu hogar, adaptadas a tu presupuesto y a las necesidades de tu familia.',
    features: [
      'Alarmas AJAX inalámbricas',
      'Videovigilancia residencial',
      'Automatización de luces y portones',
      'Respaldo energético con paneles solares',
    ],
    href: '/soluciones/hogares',
  },
  {
    icon: Building2,
    title: 'Soluciones Comerciales',
    description:
      'Escalamos soluciones de seguridad acorde a cada necesidad: negocios, comercios, oficinas e industrias.',
    features: [
      'Alarmas cableadas DSC NEO y Honeywell',
      'Sistemas contra incendios AJAX Fire',
      'Videovigilancia multi-cámara',
      'Automatización integral',
    ],
    href: '/soluciones/negocios',
  },
];
---

<section class="bg-segumax-bg-alt py-20">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <span class="font-display text-sm font-semibold tracking-widest text-segumax-accent">
        SOLUCIONES
      </span>
      <h2 class="font-display mt-4 text-4xl font-bold tracking-tight text-segumax-primary lg:text-5xl">
        Protegemos lo que más te importa
      </h2>
      <p class="mt-4 text-lg text-segumax-text-soft">
        Cada propiedad es diferente. Diseñamos soluciones a la medida.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
      {solutions.map((solution) => (
        <div class="group flex flex-col rounded-2xl border border-segumax-border bg-white p-8 shadow-card transition hover:-translate-y-1 hover:shadow-card-hover lg:p-10">
          <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-segumax-primary transition group-hover:bg-segumax-accent">
            <solution.icon class="h-7 w-7 text-white" />
          </div>

          <h3 class="font-display mt-6 text-3xl font-bold text-segumax-primary">
            {solution.title}
          </h3>
          <p class="mt-3 text-segumax-text-soft">{solution.description}</p>

          <ul class="mt-6 flex-1 space-y-3">
            {solution.features.map((feature) => (
              <li class="flex items-start gap-3">
                <div class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-segumax-accent" />
                <span class="text-sm text-segumax-text">{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={solution.href}
            class="font-display mt-8 inline-flex items-center gap-2 text-lg font-semibold tracking-wide text-segumax-accent transition hover:gap-3"
          >
            Ver soluciones
            <ArrowRight class="h-5 w-5" />
          </a>
        </div>
      ))}
    </div>
  </Container>
</section>