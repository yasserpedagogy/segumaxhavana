---
interface Props {
  class?: string;
  width?: 'default' | 'wide' | 'narrow';
}

const { class: className = '', width = 'default' } = Astro.props;

const widthClass = {
  narrow: 'max-w-4xl',
  default: 'max-w-6xl',
  wide: 'max-w-7xl',
}[width];
---

<div class:list={['mx-auto w-full px-6 sm:px-8 lg:px-12', widthClass, className]}>
  <slot />
</div>