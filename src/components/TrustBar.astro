---
import Container from './Container.astro';

const stats = [
  { value: '12+', label: 'Años de servicio' },
  { value: '500+', label: 'Hogares protegidos' },
  { value: '150+', label: 'Negocios blindados' },
  { value: '24/7', label: 'Monitoreo autónomo' },
];
---

<section class="border-b border-gris-200 bg-gris-100">
  <Container>
    <!-- Grid modular donde las líneas de separación son de un píxel exacto -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-gris-200 border-x border-gris-200">
      {stats.map((stat, i) => (
        <div class="bg-white px-6 py-10 lg:px-8 lg:py-12 flex flex-col justify-between group transition-colors duration-300 hover:bg-gris-50 relative">
          
          <!-- Metadato de catálogo en la parte superior de cada tarjeta -->
          <div class="font-mono text-[9px] text-gris-400 mb-6 tracking-widest select-none">
            [ DATA_REF // 0{i + 1} ]
          </div>

          <!-- Métrica técnica masiva con alineación limpia -->
          <div class="space-y-2">
            <span class="block text-4xl lg:text-5xl font-black tracking-tighter text-gris-900 font-mono">
              {stat.value}
            </span>
            <span class="block font-sans text-xs uppercase tracking-wider font-semibold text-gris-500 group-hover:text-gris-900 transition-colors">
              {stat.label}
            </span>
          </div>

          <!-- Pequeño nodo de estado clínico (Acento sutil) -->
          <div class="absolute bottom-4 right-4 h-1 w-1 bg-gris-300 group-hover:bg-mostaza-500 transition-colors"></div>
        </div>
      ))}
    </div>
  </Container>
</section>
