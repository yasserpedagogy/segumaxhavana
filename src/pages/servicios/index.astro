---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { getCollection } from 'astro:content';
import {
  BellRing, Cable, Flame, Camera, DoorOpen, Lightbulb, Sun, ArrowUpRight,
} from '@lucide/astro';

const iconMap = { BellRing, Cable, Flame, Camera, DoorOpen, Lightbulb, Sun };

const servicios = (await getCollection('servicios')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout
  title="Catálogo de Sistemas | SEGUMAX"
  description="Alarmas AJAX perimetrales, cctv masivo, protección térmica y matrices de energía solar modulares en La Habana."
>
  <!-- Architectural Directory Entry Hero -->
  <section class="bg-gris-50 pt-24 pb-16 lg:pt-32 lg:pb-24 border-b border-gris-200">
    <Container>
      <div class="flex flex-col border-b border-gris-200 pb-4 mb-12">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full"></span>
          <span>ESTUDIO // ÍNDICE DE INFRAESTRUCTURA DISPONIBLE</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest mt-1">CAT_REF_V26</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 items-end">
        <h1 class="display-xl text-5xl md:text-7xl lg:text-8xl text-gris-900 tracking-tighter">
          SISTEMAS DE <br />
          INGENIERÍA <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">MODULAR</span>.
        </h1>
        <p class="text-base lg:text-lg text-gris-500 font-light leading-relaxed max-w-md">
          Índice unificado de equipamiento certificado. Cada bloque opera de forma independiente o integrado en matrices de respaldo solar autónomo de baja huella espacial.
        </p>
      </div>
    </Container>
  </section>

  <!-- Technical Inventory Inventory Grid -->
  <section class="bg-gris-100 py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <!-- Perfectly aligned catalog matrix with 1px gray lines separating rows -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gris-200 border border-gris-200">
        {servicios.map((servicio, index) => {
          // FIXED: Safeguard resolution map ensures valid factory reference compilation to prevent InvalidComponentArgs
          const rawIcon = iconMap[servicio.data.icon as keyof typeof iconMap];
          const TargetIcon = rawIcon || Camera;
          
          return (
            <a
              href={`/servicios/${servicio.id}`}
              class="ikea-box bg-white p-8 flex flex-col justify-between aspect-[4/4] group h-full relative"
            >
              <!-- Technical Catalog Item Metadata -->
              <div class="font-mono text-[9px] text-gris-400 tracking-widest select-none flex justify-between items-center mb-6">
                <span>[ REF // 0{index + 1} ]</span>
                <span class="text-gris-300 font-mono group-hover:text-mostaza-500 transition-colors">// ACC_SYS</span>
              </div>

              <!-- Main Content block -->
              <div class="space-y-4">
                <!-- Sits neatly with zero backgrounds inside a technical footprint cell -->
                <div class="text-gris-400 group-hover:text-mostaza-500 transition-colors duration-300">
                  <TargetIcon class="h-7 w-7 stroke-[1.2]" />
                </div>
                
                <h2 class="text-2xl font-bold tracking-tight text-gris-900 font-sans uppercase pt-2">
                  {servicio.data.title}
                </h2>
                
                <p class="text-sm leading-relaxed text-gris-500 font-light line-clamp-3">
                  {servicio.data.description}
                </p>
              </div>

              <!-- Technical Interactive Node Footer -->
              <div class="mt-8 pt-4 border-t border-gris-100 flex items-center justify-between font-mono text-xs text-gris-400 group-hover:text-gris-900 transition-colors">
                <span class="kicker text-[10px] tracking-wider">Ver Especificaciones</span>
                <span class="w-7 h-7 rounded-full bg-gris-50 border border-gris-200 flex items-center justify-center group-hover:bg-mostaza-500 group-hover:text-gris-900 group-hover:border-mostaza-500 transition-all duration-300">
                  <ArrowUpRight class="h-3.5 w-3.5 stroke-[1.5]" />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- Closing Technical Audit Call to Action -->
  <section class="bg-white py-20 lg:py-28 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-20 items-center">
        
        <div class="space-y-4">
          <span class="font-mono text-xs text-mostaza-500 block tracking-wider">// CONTROL DE COMPATIBILIDAD ASISTIDO</span>
          <h2 class="display-lg text-3xl lg:text-5xl text-gris-900 uppercase tracking-tight">
            ¿Requiere una <br />
            configuración <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">combinada</span>?
          </h2>
          <p class="text-sm lg:text-base leading-relaxed text-gris-500 font-light max-w-xl">
            Si su propiedad requiere el emparejamiento asimismo de cámaras CCTV perimetrales con matrices híbridas solares, programamos visitas de diseño técnico in situ sin ningún coste operativo.
          </p>
        </div>

        <div class="lg:justify-self-end w-full sm:w-auto">
          <a
            href="/contacto"
            class="group inline-flex w-full sm:w-auto items-center justify-between gap-8 bg-gris-900 text-white font-mono text-xs uppercase tracking-wider px-8 py-5 transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 shadow-sm"
          >
            <span>Solicitar Auditoría Perimetral _</span>
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width={2} />
          </a>
        </div>

      </div>
    </Container>
  </section>
</Layout>
