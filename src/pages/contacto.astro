---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import { Phone, MessageCircle, Mail, MapPin } from '@lucide/astro';

const contactChannels = [
  {
    icon: Phone,
    title: 'CANAL TELEFÓNICO',
    value: '+53 5555 5555',
    href: 'tel:+5355555555',
    description: 'LUN-VIE // 08:00 - 18:00',
  },
  {
    icon: MessageCircle,
    title: 'WHATSAPP EN LÍNEA',
    value: '+53 5555 5555',
    href: 'https://wa.me',
    description: 'RESPUESTA ASISTIDA CRÍTICA',
  },
  {
    icon: Mail,
    title: 'CORREO ELECTRÓNICO',
    value: 'info@segumaxhavana.com',
    href: 'mailto:info@segumaxhavana.com',
    description: 'TIEMPO DE RESPUESTA < 24H',
  },
  {
    icon: MapPin,
    title: 'CENTRO LOGÍSTICO',
    value: 'LA HABANA, CUBA',
    href: null,
    description: 'COBERTURA EN TODO EL PAÍS',
  },
];
---

<Layout
  title="Terminal de Contacto | SEGUMAX"
  description="Solicite una inspección perimetral y auditoría estructural fotovoltaica sin compromiso en La Habana."
>
  <!-- Minimalist Structural Section Entry Hero -->
  <section class="bg-gris-50 pt-24 pb-16 lg:pt-32 lg:pb-24 border-b border-gris-200">
    <Container>
      <div class="flex items-center justify-between border-b border-gris-200 pb-4 mb-12">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full animate-pulse"></span>
          <span>NODO CENTRAL // SOLICITUD DE ASISTENCIA</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest">FORM_SYS_V4</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 items-end">
        <h1 class="display-xl text-5xl md:text-7xl lg:text-8xl text-gris-900 tracking-tighter uppercase">
          CONECTAR <br />
          CON <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">ESTUDIO</span>.
        </h1>
        <p class="text-base lg:text-lg text-gris-500 font-light leading-relaxed max-w-md">
          Programe el dimensionamiento en sitio de matrices de CCTV e ingeniería fotovoltaica de respaldo. Inspecciones estructurales libres de coste operativo.
        </p>
      </div>
    </Container>
  </section>

  <!-- 1px Metric Communication Channels Layout Grid -->
  <section class="bg-gris-100 py-12 lg:py-16 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 gap-px bg-gris-200 border border-gris-200 sm:grid-cols-2 lg:grid-cols-4">
        {contactChannels.map((channel) => {
          const CardWrapper = channel.href ? 'a' : 'div';
          const Icon = channel.icon; // Correct way to pass the Astro factory
          return (
            <CardWrapper
              href={channel.href}
              class="ikea-box bg-white p-6 flex flex-col justify-between aspect-square group relative"
            >
              <div class="font-mono text-[9px] text-gris-400 tracking-widest select-none flex justify-between items-center mb-4">
                <span>[ {channel.title} ]</span>
                <div class="text-gris-400 group-hover:text-mostaza-500 transition-colors duration-300">
                  <Icon class="h-4 w-4 stroke-[1.5]" />
                </div>
              </div>

              <div class="space-y-2 mt-auto">
                <p class="text-xl font-bold tracking-tight text-gris-900 font-mono break-all">{channel.value}</p>
                <p class="font-mono text-[10px] tracking-wider text-gris-400 uppercase">{channel.description}</p>
              </div>
            </CardWrapper>
          );
        })}
      </div>
    </Container>
  </section>
  <!-- Main System Intake Form Frame -->
  <section class="bg-white py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-[1.8fr_1fr] items-start">
        
        <!-- Left Column Form Component -->
        <div class="space-y-10">
          <div class="space-y-2 border-b border-gris-200 pb-6">
            <span class="font-mono text-xs text-mostaza-500 block tracking-wider uppercase">// REGISTRO DE AUDITORÍA</span>
            <h2 class="text-3xl font-bold tracking-tight text-gris-900 font-sans uppercase">
              Formulario de Requerimiento Técnico
            </h2>
          </div>

          <form
            action="https://web3forms.com"
            method="POST"
            class="space-y-6"
          >
            <input type="hidden" name="access_key" value="TU_ACCESS_KEY_AQUI" />
            <input type="hidden" name="subject" value="Nuevo contacto desde Segumax" />
            <input type="hidden" name="from_name" value="Web Segumax" />

            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div class="space-y-2">
                <label for="name" class="font-mono text-[11px] font-semibold text-gris-700 tracking-wider uppercase">
                  01 // Nombre Completo o Entidad *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full bg-gris-50 border border-gris-200 p-4 font-sans text-sm text-gris-900 rounded-none transition-colors focus:border-mostaza-500 focus:bg-white focus:outline-none"
                  placeholder="Ej. Estudio Arquitectura / Residencia"
                />
              </div>

              <div class="space-y-2">
                <label for="phone" class="font-mono text-[11px] font-semibold text-gris-700 tracking-wider uppercase">
                  02 // Terminal de Teléfono *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="w-full bg-gris-50 border border-gris-200 p-4 font-mono text-sm text-gris-900 rounded-none transition-colors focus:border-mostaza-500 focus:bg-white focus:outline-none"
                  placeholder="+53 5 555 5555"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label for="email" class="font-mono text-[11px] font-semibold text-gris-700 tracking-wider uppercase">
                03 // Dirección de Correo Electrónico
              </label>
              <input
                type="email"
                id="email"
                name="email"
                class="w-full bg-gris-50 border border-gris-200 p-4 font-mono text-sm text-gris-900 rounded-none transition-colors focus:border-mostaza-500 focus:bg-white focus:outline-none"
                placeholder="nombre@dominio.com"
              />
            </div>

            <div class="space-y-2">
              <label for="service" class="font-mono text-[11px] font-semibold text-gris-700 tracking-wider uppercase">
                04 // Configuración Modular Requerida *
              </label>
              <select
                id="service"
                name="service"
                required
                class="w-full bg-gris-50 border border-gris-200 p-4 font-mono text-xs text-gris-900 rounded-none tracking-wide transition-colors focus:border-mostaza-500 focus:bg-white focus:outline-none appearance-none cursor-pointer"
              >
                <option value="" class="font-mono">SELECCIONE SUBSISTEMA DE INTERÉS</option>
                <option value="alarmas-ajax">01 // ALARMAS AJAX INALÁMBRICAS</option>
                <option value="alarmas-cableadas">02 // INFRAESTRUCTURA CABLEADA ROBUSTA</option>
                <option value="incendio">03 // MATRIZ CONTRA INCENDIOS TERMO-SENSENCIAL</option>
                <option value="videovigilancia">04 // CIRCUITOS DE CCTV ANALÍTICO 4K</option>
                <option value="videoporteros">05 // SISTEMAS DE CONTROL BIOMÉTRICO</option>
                <option value="automatizacion">06 // DETECTORES DOMÓTICOS DE RELÉ</option>
                <option value="energia-solar">07 // RESPALDO ENERGÉTICO FOTOVOLTAICO</option>
                <option value="integral">08 // ARQUITECTURA INTEGRAL RESILIENTE</option>
              </select>
            </div>

            <div class="space-y-2">
              <label for="message" class="font-mono text-[11px] font-semibold text-gris-700 tracking-wider uppercase">
                05 // Descripción de Estructura Perimetral *
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full resize-none bg-gris-50 border border-gris-200 p-4 font-sans text-sm text-gris-900 rounded-none transition-colors focus:border-mostaza-500 focus:bg-white focus:outline-none"
                placeholder="Especifique dimensiones físicas de la propiedad y vulnerabilidades críticas..."
              ></textarea>
            </div>

            <div class="pt-4">
              <button
                type="submit"
                class="w-full bg-gris-900 text-white font-mono text-xs uppercase tracking-widest py-5 transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 cursor-pointer shadow-sm"
              >
                Transmitir Solicitud Técnica _
              </button>
            </div>

            <p class="text-center font-mono text-[10px] text-gris-400 tracking-wide uppercase select-none">
              Procesamiento de datos cifrado de extremo a extremo. Cero publicidad.
            </p>
          </form>
        </div>

        <!-- Right Side Frame: Quality Guidelines -->
        <aside class="space-y-6 lg:sticky lg:top-28">
          <div class="ikea-box bg-white p-6 md:p-8 border border-gris-200 relative">
            <span class="absolute top-4 right-4 font-mono text-[9px] text-gris-400 tracking-wider">GUIDE_04</span>
            <h2 class="font-mono text-[11px] text-gris-900 font-semibold tracking-wider uppercase mb-6">
              [ DIRECTRICES // ANÁLISIS ]
            </h2>
            <div class="text-xs text-gris-500 font-light leading-relaxed space-y-4 font-sans">
              <p>
                1. Asegúrese de que el número telefónico provee prefijos válidos para agilizar la asignación logística.
              </p>
              <p>
                2. Las visitas se coordinan en tramos horarios de control estricto para evitar interrupciones de seguridad.
              </p>
              <p>
                3. Los planos de red generados por nuestros ingenieros son de carácter confidencial de alta seguridad.
              </p>
            </div>
            <div class="mt-8 pt-4 border-t border-gris-100 font-mono text-[9px] text-gris-400 flex justify-between items-center">
              <span>SOPORTE SEGUMAX HQ</span>
              <div class="h-2 w-2 bg-mostaza-500 rounded-full"></div>
            </div>
          </div>
        </aside>

      </div>
    </Container>
  </section>
</Layout>
