---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { Home, Building2, ArrowUpRight, Check } from '@lucide/astro';

const soluciones = [
  {
    icon: Home,
    title: 'Para Hogares',
    slug: 'hogares',
    description:
      'Ofrecemos soluciones de respaldo y protección para su hogar, adaptadas a su presupuesto y necesidades familiares.',
    features: [
      'Alarmas AJAX inalámbricas perimetrales',
      'Videovigilancia residencial de alta definición',
      'Automatización domótica de luces y accesos',
      'Videoporteros digitales integrados',
      'Respaldo energético con paneles solares autónomos',
      'Monitoreo perimetral y soporte permanente',
    ],
  },
  {
    icon: Building2,
    title: 'Soluciones Comerciales',
    slug: 'negocios',
    description:
      'Escalamos soluciones de seguridad acorde a cada necesidad: comercios, oficinas, industrias y más.',
    features: [
      'Alarmas cableadas de alta densidad DSC NEO',
      'Sistemas contra incendios AJAX Fire avanzados',
      'Circuitos cerrados de CCTV multi-cámara 4K',
      'Controles biométricos de acceso corporativo',
      'Automatización de relés en instalaciones complejas',
      'Soporte técnico estructurado y mantenimiento cíclico',
    ],
  },
];
---

<Layout
  title="Sistemas de Seguridad por Sector | SEGUMAX"
  description="Diseño e ingeniería de infraestructura perimetral y respaldo solar a la medida de propiedades residenciales y comerciales en La Habana."
>
  <!-- Architectural Directory Entry Hero -->
  <section class="bg-gris-50 pt-24 pb-16 lg:pt-32 lg:pb-24 border-b border-gris-200">
    <Container>
      <div class="flex flex-col border-b border-gris-200 pb-4 mb-12">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full"></span>
          <span>ESTUDIO // CONFIGURACIÓN DE ENTORNOS OPERATIVOS</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest mt-1">SECTOR_INDEX_V26</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 items-end">
        <h1 class="display-xl text-5xl md:text-7xl lg:text-8xl text-gris-900 tracking-tighter">
          SEGMENTACIÓN <br />
          DE <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">ENTORNOS</span>.
        </h1>
        <p class="text-base lg:text-lg text-gris-500 font-light leading-relaxed max-w-md">
          Modelamos redes de seguridad electrónica optimizadas para las exigencias estructurales específicas de la arquitectura doméstica y corporativa.
        </p>
      </div>
    </Container>
  </section>

  <!-- Symmetric Catalog Dual Split Grid -->
  <section class="bg-gris-100 py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        {soluciones.map((solucion, index) => {
          const SectorIcon = solucion.icon;
          return (
            <a
              href={`/soluciones/${solucion.slug}`}
              class="ikea-box bg-white p-6 md:p-8 lg:p-10 border border-gris-200 relative flex flex-col justify-between group h-full"
            >
              <div>
                <!-- Technical Metadata Header Label -->
                <div class="font-mono text-[9px] text-gris-400 tracking-widest select-none flex justify-between items-center mb-8">
                  <span>[ SECTOR_REF // 0{index + 1} ]</span>
                  <div class="text-gris-400 group-hover:text-mostaza-500 transition-colors duration-300">
                    <SectorIcon class="h-5 w-5 stroke-[1.5]" />
                  </div>
                </div>

                <!-- Main Content Data Area -->
                <div class="space-y-4">
                  <h2 class="text-3xl font-bold tracking-tight text-gris-900 font-sans uppercase">
                    {solucion.title}
                  </h2>
                  <p class="text-sm leading-relaxed text-gris-500 font-light max-w-md">
                    {solucion.description}
                  </p>
                </div>

                <!-- Technical Features Included Inventory Checklist -->
                <ul class="mt-8 space-y-3.5 border-t border-gris-100 pt-6">
                  {solucion.features.map((feature) => (
                    <li class="flex items-start gap-3">
                      <div class="mt-0.5 flex h-4 w-4 flex-shrink-0 items-center justify-center text-mostaza-500">
                        <Check class="h-4 w-4 stroke-[2.5]" />
                      </div>
                      <span class="text-xs text-gris-600 font-light uppercase tracking-wide font-sans">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Interactive Node Selector Action Footer -->
              <div class="mt-10 pt-4 border-t border-gris-200 flex items-center justify-between font-mono text-xs text-gris-400 group-hover:text-gris-900 transition-colors">
                <span class="kicker text-[10px] tracking-wider">Ver Especificaciones Técnicas</span>
                <span class="w-8 h-8 rounded-full bg-gris-50 border border-gris-200 flex items-center justify-center group-hover:bg-mostaza-500 group-hover:text-gris-900 group-hover:border-mostaza-500 transition-all duration-300">
                  <ArrowUpRight class="h-4 w-4 stroke-[1.5]" />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- Technical Audit Closing Zone -->
  <section class="bg-white py-20 lg:py-28 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-20 items-center">
        
        <div class="space-y-4">
          <span class="font-mono text-xs text-mostaza-500 block tracking-wider uppercase">// EVALUACIÓN DE COMPATIBILIDAD ESTRUCTURAL</span>
          <h2 class="display-lg text-3xl lg:text-5xl text-gris-900 uppercase tracking-tight">
            ¿Incapaz de <br />
            clasificar <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">su entorno</span>?
          </h2>
          <p class="text-sm lg:text-base leading-relaxed text-gris-500 font-light max-w-xl">
            Si sus instalaciones unifican áreas comerciales abiertas con perímetros residenciales privados, programamos visitas técnicas conjuntas de despiece técnico libres de costes logísticos.
          </p>
        </div>

        <div class="lg:justify-self-end w-full sm:w-auto">
          <a
            href="/contacto"
            class="group inline-flex w-full sm:w-auto items-center justify-between gap-8 bg-gris-900 text-white font-mono text-xs uppercase tracking-wider px-8 py-5 transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 shadow-sm"
          >
            <span>Agendar Inspección de Sitio _</span>
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width={2} />
          </a>
        </div>

      </div>
    </Container>
  </section>
</Layout>
