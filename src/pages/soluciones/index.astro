---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { Home, Building2, ArrowRight, Check } from '@lucide/astro';

const soluciones = [
  {
    icon: Home,
    title: 'Para Hogares',
    slug: 'hogares',
    description:
      'Ofrecemos soluciones de respaldo y protección para su hogar, adaptadas a su presupuesto y necesidades familiares.',
    features: [
      'Alarmas AJAX inalámbricas',
      'Videovigilancia residencial',
      'Automatización de luces y portones',
      'Videoporteros digitales',
      'Respaldo energético con paneles solares',
      'Monitoreo 24/7 desde nuestra central',
    ],
  },
  {
    icon: Building2,
    title: 'Soluciones Comerciales',
    slug: 'negocios',
    description:
      'Escalamos soluciones de seguridad acorde a cada necesidad: comercios, oficinas, industrias y más.',
    features: [
      'Alarmas cableadas DSC NEO y Honeywell',
      'Sistemas contra incendios AJAX Fire',
      'Videovigilancia multi-cámara',
      'Control de acceso y videoporteros',
      'Automatización integral de instalaciones',
      'Soporte técnico y mantenimiento continuo',
    ],
  },
];
---

<Layout
  title="Soluciones | Segumax"
  description="Soluciones de seguridad para hogares y negocios en La Habana. Diseñadas a la medida según tu presupuesto."
>
  <!-- Hero -->
  <section class="bg-segumax-primary py-16 text-white lg:py-20">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <span class="font-display text-sm font-semibold tracking-widest text-segumax-accent">
          SOLUCIONES
        </span>
        <h1 class="font-display mt-4 text-4xl font-bold tracking-tight lg:text-5xl">
          Protegemos lo que más te importa
        </h1>
        <p class="mt-4 text-lg text-white/70">
          Cada propiedad es diferente. Diseñamos soluciones a la medida, ya sea
          para tu hogar o tu negocio.
        </p>
      </div>
    </Container>
  </section>

  <!-- Dos tarjetas grandes -->
  <section class="bg-segumax-bg py-16 lg:py-20">
    <Container>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        {soluciones.map((solucion) => (
          <a
            href={`/soluciones/${solucion.slug}`}
            class="group flex flex-col rounded-2xl border border-segumax-border bg-white p-8 shadow-card transition hover:-translate-y-1 hover:border-segumax-accent/30 hover:shadow-card-hover lg:p-10"
          >
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-segumax-primary transition group-hover:bg-segumax-accent">
              <solucion.icon class="h-7 w-7 text-white" />
            </div>

            <h2 class="font-display mt-6 text-3xl font-bold text-segumax-primary">
              {solucion.title}
            </h2>
            <p class="mt-3 text-segumax-text-soft">{solucion.description}</p>

            <ul class="mt-6 flex-1 space-y-3">
              {solucion.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <div class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-segumax-accent/10">
                    <Check class="h-3 w-3 text-segumax-accent" stroke-width={3} />
                  </div>
                  <span class="text-sm text-segumax-text">{feature}</span>
                </li>
              ))}
            </ul>

            <div class="mt-8 flex items-center gap-2 text-lg font-semibold text-segumax-accent transition group-hover:gap-3">
              <span class="font-display tracking-wide">Ver soluciones</span>
              <ArrowRight class="h-5 w-5" />
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA visita gratuita -->
  <section class="bg-segumax-bg-alt py-16">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="font-display text-3xl font-bold text-segumax-primary lg:text-4xl">
          ¿No sabes cuál elegir?
        </h2>
        <p class="mt-3 text-segumax-text-soft">
          Visitamos tu propiedad sin compromiso y te recomendamos la mejor
          solución según tus necesidades reales.
        </p>
        <a
          href="/contacto"
          class="font-display mt-6 inline-block rounded-lg bg-segumax-accent px-6 py-3 text-lg font-semibold tracking-wide text-white transition hover:bg-segumax-accent-hover"
        >
          Solicitar visita gratuita
        </a>
      </div>
    </Container>
  </section>
</Layout>