---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { Building2, Cable, Flame, Camera, ShieldCheck, Wrench, ArrowUpRight, Check } from '@lucide/astro';

const pilares = [
  {
    icon: Cable,
    title: 'ALARMAS CABLEADAS',
    description: 'Sistemas robustos DSC NEO y Honeywell con topología en bus blindada para perímetros complejos de alta densidad.',
  },
  {
    icon: Flame,
    title: 'CONTRA INCENDIOS',
    description: 'Matrices térmicas y de humo avanzadas AJAX Fire para la detección temprana certificada y salvaguarda de activos.',
  },
  {
    icon: Camera,
    title: 'CCTV MASIVO 4K',
    description: 'Circuitos cerrados multi-óptica con analíticas neuronales avanzadas y grabación cíclica local ininterrumpida.',
  },
  {
    icon: ShieldCheck,
    title: 'CONTROL DE ACCESO',
    description: 'Videoporteros industriales, cerraduras magnéticas y autenticación biométrica centralizada para áreas restringidas.',
  },
  {
    icon: Wrench,
    title: 'AUTOMATIZACIÓN EN LÍNEA',
    description: 'Control de relés modulares para programar escenas de iluminación, portones mecánicos y desconexión de plantas.',
  },
  {
    icon: Building2,
    title: 'MATRIZ ESCALABLE',
    description: 'Infraestructura de control expandible por módulos cíclicos sin incurrir en modificaciones estructurales costosas.',
  },
];
---

<Layout
  title="Soluciones Corporativas y Comerciales | SEGUMAX"
  description="Ingeniería y diseño de seguridad perimetral, control de accesos biométricos y CCTV avanzado para comercios, oficinas e industrias en La Habana."
>
  <!-- Architectural Directory Entry Hero -->
  <section class="bg-gris-50 pt-24 pb-16 lg:pt-32 lg:pb-24 border-b border-gris-200">
    <Container>
      <div class="flex flex-col border-b border-gris-200 pb-4 mb-12">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full"></span>
          <span>ESTUDIO // ARQUITECTURA DE SEGURIDAD COMERCIAL</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest mt-1">COM_SOLUTIONS_V26</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 items-end">
        <h1 class="display-xl text-5xl md:text-7xl lg:text-8xl text-gris-900 tracking-tighter">
          INFRAESTRUCTURA <br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">CORPORATIVA</span>.
        </h1>
        <p class="text-base lg:text-lg text-gris-500 font-light leading-relaxed max-w-md">
          Modelamos celdas perimetrales, controles de tránsito y redes redundantes para blindar las operaciones de establecimientos empresariales.
        </p>
      </div>
    </Container>
  </section>

  <!-- Modular Pillars Matrix Layout Grid -->
  <section class="bg-gris-100 py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <div class="flex flex-col border-b border-gris-200 pb-4 mb-16">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-mostaza-500 rounded-full"></span>
          <span>MÓDULOS DE INTEGRACIÓN INDUSTRIAL COMPATIBLES</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest mt-1">CORP_CELLS</span>
      </div>

      <!-- Aligned catalog layout separating cells with crisp 1px lines -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gris-200 border border-gris-200">
        {pilares.map((pilar, index) => {
          const PilarIcon = pilar.icon;
          return (
            <div class="ikea-box bg-white p-8 flex flex-col justify-between aspect-square h-full relative group">
              <div class="font-mono text-[9px] text-gris-400 tracking-widest select-none flex justify-between items-center mb-6">
                <span>[ COMP_ID // 0{index + 1} ]</span>
                <div class="text-gris-400 group-hover:text-mostaza-500 transition-colors duration-300">
                  <PilarIcon class="h-5 w-5 stroke-[1.5]" />
                </div>
              </div>

              <div class="space-y-3 mt-auto">
                <h3 class="text-xl font-bold tracking-tight text-gris-900 font-sans uppercase">
                  {pilar.title}
                </h3>
                <p class="text-xs leading-relaxed text-gris-500 font-light">
                  {pilar.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>
  <!-- Technical Features & Specifications Blueprint Split Panel -->
  <section class="bg-white py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 items-center">
        
        <!-- Left Column: Verification List Specifications -->
        <div class="lg:col-span-7 space-y-8">
          <span class="font-mono text-xs text-mostaza-500 block tracking-wider uppercase">// CONTINUIDAD DE OPERACIONES</span>
          <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-gris-900 font-sans uppercase">
            Protección de activos con respaldo energético redundante.
          </h2>
          <p class="text-sm leading-relaxed text-gris-500 font-light max-w-xl">
            Su firma corporativa no puede detener su ritmo. Nuestros diseños perimetrales incorporan sistemas híbridos solares y almacenamiento asistido para operar bajo contingencias masivas en La Habana.
          </p>
          
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 font-sans">
            {[
              'Instalación técnica fuera de ventanas de horario comercial',
              'Cumplimiento estricto de normativas de seguridad europea',
              'Redes redundantes enlazadas a nuestra central de control',
              'Soporte prioritario e inmediato por contrato de servicio',
              'Mantenimiento preventivo cíclico sin paradas operativas',
              'Entrega de planimetría y documentación técnica unificada',
            ].map((item) => (
              <li class="flex items-start gap-3 border-b border-gris-100 pb-3 last:border-0 last:pb-0">
                <div class="mt-0.5 flex h-4 w-4 flex-shrink-0 items-center justify-center text-mostaza-500">
                  <Check class="h-4 w-4 stroke-[2.5]" />
                </div>
                <span class="text-xs text-gris-600 font-light uppercase tracking-wide leading-tight">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Right Column: Visual Placement Blueprint Box -->
        <div class="lg:col-span-5 relative group">
          <div class="ikea-box bg-white p-6 md:p-8 border border-gris-200 relative">
            <span class="absolute top-4 right-4 font-mono text-[9px] text-gris-400 tracking-wider">REG. PL_COM_2026</span>
            
            <div class="font-mono text-[11px] text-gris-400 mb-6 flex items-center gap-2">
              <span>[ PLATERÍA DE CONTROL // MATRIZ ]</span>
            </div>

            <div class="relative aspect-[4/3] w-full overflow-hidden bg-gris-100 border border-gris-200 flex flex-col justify-between p-6">
              <div class="absolute inset-0 bg-[linear-gradient(to_right,#E5E7EB_1px,transparent_1px),linear-gradient(to_bottom,#E5E7EB_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] opacity-20"></div>
              
              <span class="font-mono text-[9px] text-gris-400 block tracking-widest">// DEPLOY_CORP_HQ</span>
              
              <div class="text-center z-10 space-y-1">
                <span class="block kicker text-gris-400 font-medium">DIAGRAMA DE RED CORPORATIVA</span>
                <span class="font-mono text-[10px] text-gris-400 font-light">[ CCTV Centralizado / Nodos Biométricos ]</span>
              </div>

              <div class="absolute bottom-0 right-0 h-12 w-12 bg-mostaza-500 transition-transform duration-300 group-hover:scale-105"></div>
            </div>

            <div class="mt-6 flex items-center justify-between text-xs border-t border-gris-200 pt-4 font-mono">
              <span class="kicker text-gris-900 font-semibold">TIPO DE INFRAESTRUCTURA</span>
              <span class="text-gris-400 uppercase">[ ESCALABLE / MULTI-MÓDULO ]</span>
            </div>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- Technical Audit Closing Zone (Inverted Technical Layout Block) -->
  <section class="bg-gris-900 text-white py-20 lg:py-28 border-b border-gris-900 overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-20 items-center">
        
        <div class="space-y-4">
          <div class="font-mono text-xs text-mostaza-500 block tracking-wider uppercase">// RESERVA DE TICKET PARA AUDITORÍA COMERCIAL</div>
          <h2 class="display-lg text-3xl lg:text-5xl text-white uppercase tracking-tight">
            Estructure la <br />
            auditoría de <span class="text-mostaza-500">su establecimiento</span>.
          </h2>
          <p class="text-sm leading-relaxed text-gris-300 font-light max-w-xl">
            Asignamos un equipo corporativo certificado para mapear vectores de riesgo físico y planificar cargas solares modulares híbridas libres de costes de consultoría inicial.
          </p>
        </div>

        <div class="lg:justify-self-end w-full sm:w-auto">
          <a
            href="/contacto"
            class="group inline-flex w-full sm:w-auto items-center justify-between gap-8 bg-white border border-white px-8 py-5 font-mono text-xs uppercase tracking-wider text-gris-900 transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 hover:border-mostaza-500 shadow-sm"
          >
            <span>Agendar Auditoría Empresarial _</span>
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width={2} />
          </a>
        </div>

      </div>
    </Container>
  </section>
</Layout>
