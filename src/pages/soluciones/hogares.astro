---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import { Home, BellRing, Camera, Lightbulb, DoorOpen, Sun, ArrowUpRight, Check } from '@lucide/astro';

const pilares = [
  {
    icon: BellRing,
    title: 'ALARMAS AJAX',
    description: 'Detección volumétrica inalámbrica por radiofrecuencia con blindaje contra inhibidores y respaldo por batería pasiva.',
  },
  {
    icon: Camera,
    title: 'CIRCUITOS CCTV',
    description: 'Ópticas de alta definición con analítica de patrones, visión nocturna optimizada y enlace cifrado remoto.',
  },
  {
    icon: DoorOpen,
    title: 'VIDEOPORTEROS',
    description: 'Módulos digitales de verificación biométrica y control de acceso previo a la apertura perimetral.',
  },
  {
    icon: Lightbulb,
    title: 'AUTOMATIZACIÓN',
    description: 'Relés domóticos integrados para la gestión remota automatizada de accesos, portones y luminarias.',
  },
  {
    icon: Sun,
    title: 'ENERGÍA SOLAR',
    description: 'Matrices fotovoltaicas independientes de celdas monocristalinas para el desacople completo de la red pública.',
  },
  {
    icon: Home,
    title: 'ARQUITECTURA UNIFICADA',
    description: 'Convergencia de todos los subsistemas de ingeniería bajo una terminal de control única y transparente.',
  },
];
---

<Layout
  title="Infraestructura Residencial | SEGUMAX"
  description="Diseño e ingeniería de seguridad electrónica perimetral y matrices de energía solar autónomas para hogares en La Habana."
>
  <!-- Architectural Directory Entry Hero -->
  <section class="bg-gris-50 pt-24 pb-16 lg:pt-32 lg:pb-24 border-b border-gris-200">
    <Container>
      <div class="flex flex-col border-b border-gris-200 pb-4 mb-12">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full"></span>
          <span>ESTUDIO // SUBSISTEMAS DE PROTECCIÓN DOMÉSTICA</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest mt-1">RES_SOLUTIONS_V26</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 items-end">
        <h1 class="display-xl text-5xl md:text-7xl lg:text-8xl text-gris-900 tracking-tighter">
          ARQUITECTURA <br />
          <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">RESIDENCIAL</span>.
        </h1>
        <p class="text-base lg:text-lg text-gris-500 font-light leading-relaxed max-w-md">
          Modelamos celdas perimetrales y redes energéticas de respaldo adaptadas de forma milimétrica a la estructura física de su vivienda.
        </p>
      </div>
    </Container>
  </section>

  <!-- Modular Pillars Matrix Layout Grid -->
  <section class="bg-gris-100 py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <div class="flex flex-col border-b border-gris-200 pb-4 mb-16">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-mostaza-500 rounded-full"></span>
          <span>ÍNDICE DE COMPONENTES DISPONIBLES</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest mt-1">MATRIX_CELLS</span>
      </div>

      <!-- Aligned catalog layout separating cells with crisp 1px lines -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gris-200 border border-gris-200">
        {pilares.map((pilar, index) => {
          const PilarIcon = pilar.icon;
          return (
            <div class="ikea-box bg-white p-8 flex flex-col justify-between aspect-square h-full relative group">
              <div class="font-mono text-[9px] text-gris-400 tracking-widest select-none flex justify-between items-center mb-6">
                <span>[ COMP_ID // 0{index + 1} ]</span>
                <div class="text-gris-400 group-hover:text-mostaza-500 transition-colors duration-300">
                  <PilarIcon class="h-5 w-5 stroke-[1.5]" />
                </div>
              </div>

              <div class="space-y-3 mt-auto">
                <h3 class="text-xl font-bold tracking-tight text-gris-900 font-sans uppercase">
                  {pilar.title}
                </h3>
                <p class="text-xs leading-relaxed text-gris-500 font-light">
                  {pilar.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>
  <!-- Technical Features & Specifications Blueprint Split Panel -->
  <section class="bg-white py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 gap-16 lg:grid-cols-12 items-center">
        
        <!-- Left Column: Visual Placement Blueprint Box -->
        <div class="lg:col-span-5 relative group order-2 lg:order-1">
          <div class="ikea-box bg-white p-6 md:p-8 border border-gris-200 relative">
            <span class="absolute top-4 right-4 font-mono text-[9px] text-gris-400 tracking-wider">REG. PL_DOM_2026</span>
            
            <div class="font-mono text-[11px] text-gris-400 mb-6 flex items-center gap-2">
              <span>[ ESQUEMA VISUAL // MONTAJE ]</span>
            </div>

            <div class="relative aspect-[4/3] w-full overflow-hidden bg-gris-100 border border-gris-200 flex flex-col justify-between p-6">
              <div class="absolute inset-0 bg-[linear-gradient(to_right,#E5E7EB_1px,transparent_1px),linear-gradient(to_bottom,#E5E7EB_1px,transparent_1px)] bg-[size:1.5rem_1.5rem] opacity-20"></div>
              
              <span class="font-mono text-[9px] text-gris-400 block tracking-widest">// DEPLOY_RES_HQ</span>
              
              <div class="text-center z-10 space-y-1">
                <span class="block kicker text-gris-400 font-medium">RENDER DE INSTALACIÓN RESIDENCIAL</span>
                <span class="font-mono text-[10px] text-gris-400 font-light">[ Fachada Limpia / Integración Domótica ]</span>
              </div>

              <div class="absolute bottom-0 left-0 h-1 w-16 bg-mostaza-500 transition-all duration-300 group-hover:h-2"></div>
            </div>

            <div class="mt-6 flex items-center justify-between text-xs border-t border-gris-200 pt-4 font-mono">
              <span class="kicker text-gris-900 font-semibold">TIPO DE INSTALACIÓN</span>
              <span class="text-gris-400 uppercase">[ DISCRETA / EMPOTRADA ]</span>
            </div>
          </div>
        </div>

        <!-- Right Column: Verification List Specifications -->
        <div class="lg:col-span-7 space-y-8 order-1 lg:order-2">
          <span class="font-mono text-xs text-mostaza-500 block tracking-wider uppercase">// COMPATIBILIDAD FAMILIAR</span>
          <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-gris-900 font-sans uppercase">
            Ingeniería adaptada al espacio doméstico.
          </h2>
          
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 font-sans">
            {[
              'Ejecución limpia sin impacto estético visual',
              'Notificaciones push en tiempo real vía app móvil',
              'Supervisión técnica y calibración remota',
              'Respaldo por acumulador modular en apagones',
              'Ciclos de mantenimiento preventivo estricto',
              'Asistencia y soporte por contrato técnico',
            ].map((item) => (
              <li class="flex items-start gap-3 border-b border-gris-100 pb-3 last:border-0 last:pb-0">
                <div class="mt-0.5 flex h-4 w-4 flex-shrink-0 items-center justify-center text-mostaza-500">
                  <Check class="h-4 w-4 stroke-[2.5]" />
                </div>
                <span class="text-xs text-gris-600 font-light uppercase tracking-wide leading-tight">{item}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </Container>
  </section>

  <!-- Technical Audit Closing Zone (Inverted Technical Layout Block) -->
  <section class="bg-gris-900 text-white py-20 lg:py-28 border-b border-gris-900 overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-20 items-center">
        
        <div class="space-y-4">
          <div class="font-mono text-xs text-mostaza-500 block tracking-wider uppercase">// RESERVA DE TICKET OPERATIVO</div>
          <h2 class="display-lg text-3xl lg:text-5xl text-white uppercase tracking-tight">
            Planifique la <br />
            auditoría de <span class="text-mostaza-500">su residencia</span>.
          </h2>
          <p class="text-sm leading-relaxed text-gris-300 font-light max-w-xl">
            Asignamos un ingeniero certificado para evaluar los perímetros estructurales y la exposición lumínica fotovoltaica de su propiedad en La Habana de forma gratuita y sin compromiso contractual.
          </p>
        </div>

        <div class="lg:justify-self-end w-full sm:w-auto">
          <a
            href="/contacto"
            class="group inline-flex w-full sm:w-auto items-center justify-between gap-8 bg-white border border-white px-8 py-5 font-mono text-xs uppercase tracking-wider text-gris-900 transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 hover:border-mostaza-500 shadow-sm"
          >
            <span>Solicitar Inspección Residencial _</span>
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width={2} />
          </a>
        </div>

      </div>
    </Container>
  </section>
</Layout>
