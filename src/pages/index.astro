---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Services from '../components/Services.astro';
import SolarSection from '../components/SolarSection.astro';
import Solutions from '../components/Solutions.astro';
import FreeVisitCTA from '../components/FreeVisitCTA.astro';
import About from '../components/About.astro';
import WhyUs from '../components/WhyUs.astro';
import FinalCTA from '../components/FinalCTA.astro';
---

<Layout title="SEGUMAX | Infraestructura de Seguridad & Energía Solar">
  <!-- Envoltorio principal con retícula técnica milimétrica lateral -->
  <div class="w-full max-w-[1400px] mx-auto min-h-screen border-x border-gris-200 bg-gris-50 flex flex-col">
    
    <!-- Bloque 01: Impacto & Validación Primaria -->
    <Hero />
    <TrustBar />
    
    <!-- Bloque 02: Núcleo de Ingeniería (Servicios y Flujo) -->
    <div class="space-y-[var(--spacing-section)] md:space-y-[var(--spacing-section-lg)] py-[var(--spacing-section)]">
      <HowItWorks />
      
      <div class="editorial-rule"></div>
      <Services />
      
      <div class="editorial-rule"></div>
      <SolarSection />
    </div>

    <!-- Bloque 03: Arquitectura de Soluciones & CTA de Conversión -->
    <div class="bg-white border-t border-gris-200 py-[var(--spacing-section)] space-y-[var(--spacing-section)]">
      <Solutions />
      <FreeVisitCTA />
    </div>

    <!-- Bloque 04: Filosofía de Estudio & Cierre -->
    <div class="space-y-[var(--spacing-section)] py-[var(--spacing-section)] border-t border-gris-200">
      <About />
      <WhyUs />
      
      <div class="editorial-rule"></div>
      <FinalCTA />
    </div>

  </div>
</Layout>
