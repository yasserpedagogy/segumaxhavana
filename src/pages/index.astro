---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Segumax | Máxima Protección">
  <main class="min-h-screen bg-segumax-bg p-8">
    <h1 class="font-display text-5xl font-bold tracking-tight text-segumax-primary">
      Segumax — Prueba de Tailwind
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-segumax-text-soft">
      Si ves este texto con tipografía moderna y colores, Tailwind está funcionando.
    </p>
    <button class="font-display mt-6 rounded-lg bg-segumax-accent px-6 py-3 text-lg font-semibold tracking-wide text-white transition hover:bg-segumax-accent-hover">
      Botón de prueba
    </button>
  </main>
</Layout>