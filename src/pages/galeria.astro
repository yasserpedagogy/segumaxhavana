---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import { Camera, ImageIcon } from '@lucide/astro';

// Placeholder: cuando tengas fotos reales, esto vendrá de una colección
const categorias = ['Todas', 'Alarmas', 'Videovigilancia', 'Energía Solar', 'Automatización'];

const proyectos = [
  { id: 1, title: 'Residencia en Miramar', category: 'Alarmas', description: 'Sistema AJAX integral con 12 sensores.' },
  { id: 2, title: 'Comercio en Vedado', category: 'Videovigilancia', description: '8 cámaras Full HD con grabación 24/7.' },
  { id: 3, title: 'Casa en Playa', category: 'Energía Solar', description: 'Sistema solar con respaldo total.' },
  { id: 4, title: 'Oficina en Centro Habana', category: 'Automatización', description: 'Control de luces y accesos por móvil.' },
  { id: 5, title: 'Almacén en Marianao', category: 'Alarmas', description: 'Sistema cableado DSC NEO perimetral.' },
  { id: 6, title: 'Villa en Siboney', category: 'Videovigilancia', description: 'Cámaras con visión nocturna y acceso remoto.' },
  { id: 7, title: 'Apartamento en El Vedado', category: 'Energía Solar', description: 'Paneles solares para respaldo básico.' },
  { id: 8, title: 'Restaurante en La Habana Vieja', category: 'Automatización', description: 'Escenas de iluminación y control de portones.' },
  { id: 9, title: 'Farmacia en Centro Habana', category: 'Alarmas', description: 'Sistema AJAX con notificación instantánea.' },
];
---

<Layout
  title="Galería | Segumax"
  description="Galería de proyectos realizados por Segumax en La Habana: alarmas, videovigilancia, energía solar y automatización."
>
  <!-- Hero -->
  <section class="bg-segumax-primary py-16 text-white lg:py-20">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <span class="font-display text-sm font-semibold tracking-widest text-segumax-accent">
          GALERÍA
        </span>
        <h1 class="font-display mt-4 text-4xl font-bold tracking-tight lg:text-5xl">
          Proyectos que hablan por nosotros
        </h1>
        <p class="mt-4 text-lg text-white/70">
          Algunos de los trabajos realizados en hogares, comercios e industrias
          de La Habana.
        </p>
      </div>
    </Container>
  </section>

  <!-- Filtros + Grid -->
  <section class="bg-segumax-bg py-16 lg:py-20">
    <Container>
      <!-- Filtros (estáticos por ahora, sin JS) -->
      <div class="flex flex-wrap justify-center gap-2">
        {categorias.map((cat, i) => (
          <button
            type="button"
            class:list={[
              'font-display rounded-full px-5 py-2 text-sm font-semibold tracking-wide transition',
              i === 0
                ? 'bg-segumax-primary text-white'
                : 'border border-segumax-border bg-white text-segumax-text hover:border-segumax-accent hover:text-segumax-accent',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid de proyectos -->
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {proyectos.map((proyecto) => (
          <article class="group overflow-hidden rounded-2xl border border-segumax-border bg-white shadow-card transition hover:-translate-y-1 hover:shadow-card-hover">
            <!-- Imagen placeholder -->
            <div class="relative aspect-[4/3] overflow-hidden bg-segumax-bg-alt">
              <div class="flex h-full items-center justify-center">
                <ImageIcon class="h-16 w-16 text-segumax-primary/20" stroke-width={1.5} />
              </div>
              <!-- Badge categoría -->
              <span class="font-display absolute left-4 top-4 rounded-full bg-segumax-primary/90 px-3 py-1 text-xs font-semibold tracking-wider text-white backdrop-blur">
                {proyecto.category}
              </span>
            </div>

            <!-- Info -->
            <div class="p-6">
              <h3 class="font-display text-lg font-bold text-segumax-primary">
                {proyecto.title}
              </h3>
              <p class="mt-2 text-sm text-segumax-text-soft">
                {proyecto.description}
              </p>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- CTA final -->
  <section class="bg-segumax-bg-alt py-16">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-segumax-accent/10">
          <Camera class="h-8 w-8 text-segumax-accent" />
        </div>
        <h2 class="font-display mt-6 text-3xl font-bold text-segumax-primary lg:text-4xl">
          ¿Quieres ser nuestro próximo proyecto?
        </h2>
        <p class="mt-3 text-segumax-text-soft">
          Solicita una visita gratuita y te mostramos cómo podemos proteger tu
          propiedad.
        </p>
        <a
          href="/contacto"
          class="font-display mt-6 inline-block rounded-lg bg-segumax-accent px-6 py-3 text-lg font-semibold tracking-wide text-white transition hover:bg-segumax-accent-hover"
        >
          Solicitar visita gratuita
        </a>
      </div>
    </Container>
  </section>
</Layout>