---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import { Camera, ArrowUpRight } from '@lucide/astro';

const categorias = ['Todas', 'Alarmas', 'Videovigilancia', 'Energía Solar', 'Automatización'];

const proyectos = [
  { id: 1, title: 'Residencia en Miramar', category: 'Alarmas', description: 'Sistema AJAX integral con 12 sensores.' },
  { id: 2, title: 'Comercio en Vedado', category: 'Videovigilancia', description: '8 cámaras Full HD con grabación 24/7.' },
  { id: 3, title: 'Casa en Playa', category: 'Energía Solar', description: 'Sistema solar con respaldo total.' },
  { id: 4, title: 'Oficina en Centro Habana', category: 'Automatización', description: 'Control de luces y accesos por móvil.' },
  { id: 5, title: 'Almacén en Marianao', category: 'Alarmas', description: 'Sistema cableado DSC NEO perimetral.' },
  { id: 6, title: 'Villa en Siboney', category: 'Videovigilancia', description: 'Cámaras con visión nocturna y acceso remoto.' },
  { id: 7, title: 'Apartamento en El Vedado', category: 'Energía Solar', description: 'Paneles solares para respaldo básico.' },
  { id: 8, title: 'Restaurante en La Habana Vieja', category: 'Automatización', description: 'Escenas de iluminación y control de portones.' },
  { id: 9, title: 'Farmacia en Centro Habana', category: 'Alarmas', description: 'Sistema AJAX con notificación instantánea.' },
];
---

<Layout
  title="Archivo de Proyectos | SEGUMAX"
  description="Registro visual de infraestructura perimetral, circuitos de CCTV y matrices fotovoltaicas instaladas en La Habana."
>
  <!-- Architectural Directory Entry Hero -->
  <section class="bg-gris-50 pt-24 pb-16 lg:pt-32 lg:pb-24 border-b border-gris-200">
    <Container>
      <div class="flex flex-col border-b border-gris-200 pb-4 mb-12">
        <div class="kicker flex items-center gap-3">
          <span class="inline-block h-1.5 w-1.5 bg-marino-500 rounded-full"></span>
          <span>ESTUDIO // REGISTRO VISUAL DE INFRAESTRUCTURA ENTREGADA</span>
        </div>
        <span class="font-mono text-[10px] text-gris-400 tracking-widest mt-1">ARCH_REF_V26</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-8 items-end">
        <h1 class="display-xl text-5xl md:text-7xl lg:text-8xl text-gris-900 tracking-tighter">
          PORTAFOLIO DE <br />
          DESPLIEGUES <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">REALES</span>.
        </h1>
        <p class="text-base lg:text-lg text-gris-500 font-light leading-relaxed max-w-md">
          Índice cronológico de proyectos residenciales, comerciales e industriales ejecutados bajo estándares técnicos europeos.
        </p>
      </div>
    </Container>
  </section>

  <!-- Filter Sub-Navigation Bar -->
  <section class="bg-white border-b border-gris-200 py-6 sticky top-16 lg:top-20 z-40 backdrop-blur-md bg-white/90">
    <Container>
      <div class="flex flex-wrap items-center justify-start gap-3">
        <span class="font-mono text-[10px] text-gris-400 mr-4 tracking-wider select-none">[ FILTRAR_POR ]</span>
        {categorias.map((cat, i) => (
          <button
            type="button"
            class:list={[
              'font-mono text-xs tracking-wider uppercase px-4 py-2 border transition-all duration-300 cursor-pointer',
              i === 0
                ? 'bg-gris-900 text-white border-gris-900 font-medium pl-3 border-l-4 border-l-mostaza-500'
                : 'border-gris-200 bg-gris-50 text-gris-600 hover:border-gris-900 hover:text-gris-900',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </Container>
  </section>

  <!-- Technical Blueprint Portfolio Grid -->
  <section class="bg-gris-100 py-16 lg:py-24 border-b border-gris-200">
    <Container>
      <!-- Perfectly aligned portfolio matrix with 1px gray line separators -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-gris-200 border border-gris-200">
        {proyectos.map((proyecto) => (
          <article class="ikea-box bg-white p-6 flex flex-col justify-between group h-full relative">
            <div>
              <!-- Technical Catalog Item Metadata -->
              <div class="font-mono text-[9px] text-gris-400 tracking-widest select-none flex justify-between items-center mb-4">
                <span>[ REG_ID // 0{proyecto.id} ]</span>
                <span class="text-mostaza-600 font-mono font-medium">// {proyecto.category.toUpperCase()}</span>
              </div>

              <!-- Product / Deployment Visual Canvas -->
              <div class="relative aspect-[4/3] w-full overflow-hidden bg-gris-100 border border-gris-200 flex flex-col justify-between p-4 mb-6">
                <!-- Camera lens alignment crosshairs backdrop matrix pattern -->
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#E5E7EB_1px,transparent_1px),linear-gradient(to_bottom,#E5E7EB_1px,transparent_1px)] bg-[size:2rem_2rem] opacity-25"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-8 h-8 border border-dashed border-gris-300 rounded-full opacity-40"></div>
                
                <span class="font-mono text-[8px] text-gris-400 block tracking-widest">// RAW_IMAGE_RENDER</span>
                
                <div class="text-center z-10 space-y-1">
                  <span class="block kicker text-gris-400 font-medium">VISUALIZACIÓN DE CAMPO</span>
                  <span class="font-mono text-[9px] text-gris-400 font-light">[ Módulo Inst_alado // {proyecto.category} ]</span>
                </div>

                <!-- Small technical color check box in corner -->
                <div class="h-1.5 w-1.5 bg-gris-200 group-hover:bg-mostaza-500 transition-colors self-end"></div>
              </div>

              <!-- Information Block Area -->
              <div class="space-y-1.5">
                <h3 class="text-lg font-bold tracking-tight text-gris-900 font-sans uppercase">
                  {proyecto.title}
                </h3>
                <p class="text-xs leading-relaxed text-gris-500 font-light">
                  {proyecto.description}
                </p>
              </div>
            </div>

            <!-- Operational System State Line -->
            <div class="mt-6 pt-3 border-t border-gris-100 flex items-center justify-between font-mono text-[10px] text-gris-400">
              <span>ESTADO // VERIFICADO</span>
              <span class="text-gris-300 select-none">// SEC_OK</span>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <!-- Bottom CTA Conversion Zone -->
  <section class="bg-white py-20 lg:py-28 border-b border-gris-200">
    <Container>
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-20 items-center">
        
        <div class="space-y-4">
          <div class="w-10 h-10 border border-gris-200 bg-gris-50 flex items-center justify-center text-mostaza-500 mb-2">
            <Camera class="h-5 w-5 stroke-[1.5]" />
          </div>
          <span class="font-mono text-xs text-mostaza-500 block tracking-wider uppercase">// PROGRAMACIÓN DE PROYECTO ADICIONAL</span>
          <h2 class="display-lg text-3xl lg:text-5xl text-gris-900 uppercase tracking-tight">
            ¿Iniciamos la <br />
            auditoría de <span class="text-transparent [-webkit-text-stroke:1px_var(--color-gris-900)]">su espacio</span>?
          </h2>
          <p class="text-sm lg:text-base leading-relaxed text-gris-500 font-light max-w-xl">
            Modelamos diagramas de red unificados adaptados a las dimensiones exactas de su residencia o establecimiento comercial de forma completamente gratuita.
          </p>
        </div>

        <div class="lg:justify-self-end w-full sm:w-auto">
          <a
            href="/contacto"
            class="group inline-flex w-full sm:w-auto items-center justify-between gap-8 bg-gris-900 text-white font-mono text-xs uppercase tracking-wider px-8 py-5 transition-colors duration-300 hover:bg-mostaza-500 hover:text-gris-900 shadow-sm"
          >
            <span>Agendar Revisión Técnica _</span>
            <ArrowUpRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" stroke-width={2} />
          </a>
        </div>

      </div>
    </Container>
  </section>
</Layout>
